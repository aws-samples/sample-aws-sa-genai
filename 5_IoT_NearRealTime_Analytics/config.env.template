# ============================================================
# IoT Pipeline Configuration
# Copy this file to config.env and fill in your values.
# ============================================================

# Your AWS account ID (12-digit number)
ACCOUNT_ID=123456789012

# AWS region — must support S3 Tables (us-east-1, us-west-2, eu-west-1, ap-southeast-1)
AWS_REGION=us-east-1

# S3 Table Bucket name — must be globally unique, lowercase, no underscores
# Recommended: iot-demo-tables-${ACCOUNT_ID}
TABLE_BUCKET_NAME=iot-demo-tables-${ACCOUNT_ID}

# Namespace within the table bucket (analogous to a database schema)
NAMESPACE=iot_analytics

# Kinesis stream name
KINESIS_STREAM_NAME=iot-telemetry-stream

# Firehose delivery stream name
FIREHOSE_STREAM_NAME=iot-telemetry-firehose

# IAM role names (will be created by deploy.sh)
FIREHOSE_ROLE_NAME=IoTFirehoseDeliveryRole
LAMBDA_ROLE_NAME=IoTLambdaExecutionRole

# S3 bucket for static reference tables (organizations, machines, farms, etc.)
# This is a REGULAR S3 bucket (not S3 Tables) — used for Athena external tables
# Recommended: iot-demo-static-${ACCOUNT_ID}
STATIC_DATA_BUCKET=iot-demo-static-${ACCOUNT_ID}

# Athena output bucket for query results
# Recommended: iot-demo-athena-results-${ACCOUNT_ID}
ATHENA_OUTPUT_BUCKET=iot-demo-athena-results-${ACCOUNT_ID}

# Lambda function names
SIMULATOR_LAMBDA=iot-telemetry-simulator
ELT_LAMBDA=iot-telemetry-elt-processor

# Simulator schedule: how often to run (EventBridge cron expression)
# Default: every 1 minute
SIMULATOR_SCHEDULE="rate(1 minute)"

# ELT schedule: how often to aggregate telemetry → measurements
# Default: every hour at minute 5 (allows Firehose to flush)
ELT_SCHEDULE="cron(5 * * * ? *)"
